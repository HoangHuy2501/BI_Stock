NODE_ENV=development
PORT=3000
# true: chạy được ngay, không cần SQL Server. false: dùng DB thật
USE_MOCK=true
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=BaseBE
DB_USER=sa
DB_PASSWORD=CHANGE_ME
DB_ENCRYPT=false
# Set true only when the SQL Server uses a self-signed certificate.
DB_TRUST_CERT=true
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=1h
CORS_ORIGIN=http://localhost:5173
